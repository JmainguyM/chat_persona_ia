<%# Une conversation du dashboard : avatar du persona, dernier message, date, suppression.
    Un clic sur la ligne ouvre la conversation (stretched-link sur le nom) %>
<% last_message = chat.messages.last %>
<article class="dash-chat">
  <%= persona_avatar(chat.persona, css_class: "dash-chat-img") %>
  <div class="dash-chat-body">
    <div class="dash-chat-head">
      <h3><%= link_to chat.persona.name, chat_path(chat), class: "dash-chat-link stretched-link" %></h3>
      <time datetime="<%= chat.updated_at.iso8601 %>"><%= time_ago_in_words(chat.updated_at) %> ago</time>
    </div>
    <p>
      <% if last_message.role == "user" %>
        <%# Anciens messages sans auteur (avant les invitations) : considérés comme les nôtres %>
        <span class="dash-chat-you">
          <%= last_message.user.nil? || last_message.user == current_user ? "You" : last_message.user.username %>:
        </span>
      <% end %>
      <%= truncate(last_message.content, length: 140) %>
    </p>
  </div>
  <%# Seul le propriétaire peut supprimer la conversation %>
  <%= render "chats/delete_button", chat: chat if chat.user == current_user %>
</article>
