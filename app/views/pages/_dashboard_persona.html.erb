<%# Carte persona du dashboard. owned: true affiche le lien d'édition %>
<article class="dash-persona">
  <%= persona_avatar(persona, css_class: "dash-persona-img") %>
  <div class="dash-persona-body">
    <h3><%= persona.name %></h3>
    <% if persona.description.present? %>
      <p><%= persona.description %></p>
    <% end %>
    <div class="dash-persona-actions">
      <%# TODO: lier vers la création d'une conversation quand le modèle Conversation existera %>
      <%= link_to persona_path(persona), class: "dash-persona-link" do %>
        Chat <span aria-hidden="true">→</span>
      <% end %>
      <% if owned %>
        <%= link_to "Edit", edit_persona_path(persona), class: "dash-persona-edit" %>
      <% end %>
    </div>
  </div>
</article>
