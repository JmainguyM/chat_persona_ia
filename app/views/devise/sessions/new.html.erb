<section class="auth">
  <div class="auth-card">
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Log in to keep chatting with your personas.</p>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.input :email,
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password,
                  required: false,
                  input_html: { autocomplete: "current-password" } %>
      <div class="auth-row">
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "auth-small-link" if devise_mapping.recoverable? %>
      </div>

      <%= f.button :submit, "Log in", class: "home-btn home-btn-dark auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</section>
