<%= turbo_stream_from current_user, :credits if user_signed_in? %>
<nav class="navbar navbar-expand-md fab-navbar">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand fab-logo" do %>
      fabulae<span class="fab-logo-dot">.</span>
    <% end %>

    <%# Icône burger maison : 2 traits qui se transforment en croix à l'ouverture %>
    <button class="navbar-toggler fab-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#fabNavbar" aria-controls="fabNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span></span>
      <span></span>
    </button>

    <div class="collapse navbar-collapse" id="fabNavbar">
      <ul class="navbar-nav ms-md-auto fab-nav">
        <li class="nav-item">
          <%= link_to "Personas", personas_path, class: "nav-link fab-link" %>
        </li>
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Dashboard", dashboard_path, class: "nav-link fab-link" %>
          </li>
        <% end %>
      </ul>

      <div class="fab-auth">
        <% if user_signed_in? %>
          <%= render "shared/credits", user: current_user %>
          <%= link_to dashboard_path, class: "fab-user" do %>
            <%= current_user.username.presence || current_user.email %>
          <% end %>
          <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "home-btn fab-btn fab-btn-ghost" %>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "home-btn fab-btn fab-btn-ghost" %>
          <%= link_to "Sign up", new_user_registration_path, class: "home-btn home-btn-dark fab-btn" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
