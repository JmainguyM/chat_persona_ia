<%# Un message de la conversation. role "user" = l'utilisateur, "assistant" = la persona %>
<article class="chat-message chat-message-<%= message.role %>">
  <header class="chat-message-head">
    <span class="chat-message-author">
      <%= message.role == "user" ? "You" : persona.name %>
    </span>
    <time class="chat-message-date" datetime="<%= message.created_at.iso8601 %>">
      <%= l(message.created_at, format: :short) %>
    </time>
  </header>
  <div class="chat-message-content">
    <%= simple_format message.content %>
  </div>
</article>
